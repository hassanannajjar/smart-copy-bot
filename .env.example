# Copy to .env (gitignored). Never commit real values.
NODE_ENV=development
LOG_LEVEL=info
DATA_DIR=./data
RULES_PATH=./config/rules.yaml

# Provider keys (required by the providers that use them from M1 on)
HELIUS_API_KEY=
SOLANATRACKER_API_KEY=
BIRDEYE_API_KEY=

# Live gate (PLAN §9). Both must match exactly, and LIVE is still only entered
# from the dashboard confirmation flow. The engine always boots in PAPER.
LIVE_ENABLED=false
LIVE_CONFIRM=
