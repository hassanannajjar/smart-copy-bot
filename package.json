{
  "name": "smart-copy-bot",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "pnpm --filter @scb/shared db:generate",
    "start": "pnpm -r --reporter=silent build && node apps/engine/dist/main.js",
    "wallets:discover": "pnpm -r --reporter=silent build && node apps/engine/dist/discover/cli.js",
    "db:migrate": "pnpm --filter @scb/shared build && node packages/shared/dist/db/migrate.js",
    "db:seed:demo": "pnpm --filter @scb/shared build && node apps/dashboard/scripts/seed-demo.ts",
    "dashboard": "pnpm --filter @scb/dashboard dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^24",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  }
}
